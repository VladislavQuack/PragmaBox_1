# Строка подключения к PostgreSQL.
# Локально — база песочницы, на Vercel — адрес из Neon/Supabase.
# У облачных баз в конце обычно нужен ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Токен бота из @BotFather. Пока не задан, приложение работает в демо-режиме
# и открывается в обычном браузере под общим «Демо-тренером».
TELEGRAM_BOT_TOKEN=

# Поставь 1, если токен уже задан, но ты хочешь открывать приложение
# в браузере для отладки. На проде оставь пустым.
ALLOW_BROWSER_DEMO=

# Технические инструкции (/setup и /deploy) и ссылки на них в настройках.
# Пусто — витринный режим: страниц нет, показываем приложение клиентам.
# 1 — инструкции доступны владельцу.
SHOW_GUIDES=
